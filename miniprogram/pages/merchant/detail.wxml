<view class="page merchant">
<view class="eyebrow">STORE / 门店工作台</view>
<view class="title">预约详情</view>
<view class="subtitle">北京时间 · 单店预约管理</view>
<view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load" disabled="{{busy}}">重新加载</button></view>
<view wx:if="{{denied}}" class="empty">当前账号没有商家权限<button class="secondary" bindtap="back">返回我的预约</button></view>
<view wx:if="{{loading}}" class="empty">正在读取门店数据…</view>
<block wx:if="{{payload}}"><view class="card"><view class="row"><text class="strong">{{payload.serviceName}}</text><text class="badge">{{payload.statusLabel}}</text></view><view class="fact"><text>顾客</text><text>{{payload.customerLabel}}</text></view><view class="fact"><text>日期</text><text>{{payload.localDate}}</text></view><view class="fact"><text>到店时间</text><text>{{payload.timeLabel}}</text></view><view class="fact"><text>时长</text><text>{{payload.durationMinutes}} 分钟</text></view><view class="fact"><text>预约时价格</text><text>¥{{payload.price}}</text></view><view class="identifier">预约编号：{{payload.appointmentId}}</view></view><button wx:if="{{payload.canCancel}}" class="secondary danger" bindtap="cancelBooking" disabled="{{busy || loading}}" loading="{{busy}}">取消这笔预约</button><view class="subtitle">仅可取消尚未开始的有效预约。取消后顾客刷新可见，不会自动发送通知。预约时间已过不代表已完成服务。</view></block>
<button wx:if="{{payload}}" class="secondary refresh" bindtap="load" disabled="{{busy || loading}}">刷新数据</button>
</view>